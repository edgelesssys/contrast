@@ -653,6 +653,11 @@ func (n *LinuxNetwork) AddEndpoints(ctx context.Context, s *Sandbox, endpointsIn
 		}
 	}
 
+	// l3forwarding configures the host netns for a single pod interface.
+	if n.interworkingModel == NetXConnectL3ForwardingModel && len(n.eps) > 1 {
+		return nil, fmt.Errorf("l3forwarding supports only a single interface per network namespace, found %d", len(n.eps))
+	}
+
 	katatrace.AddTags(span, "endpoints", n.eps, "hotplug", hotplug)
 	networkLogger().Debug("Endpoints added")
 
@@ -875,6 +880,9 @@ func xConnectVMNetwork(ctx context.Context, endpoint Endpoint, h Hypervisor) err
 	case NetXConnectTCFilterModel:
 		networkLogger().Info("connect TCFilter to VM network")
 		err = setupTCFiltering(ctx, endpoint, queues, disableVhostNet)
+	case NetXConnectL3ForwardingModel:
+		networkLogger().Info("set up L3 forwarding in VM network")
+		err = setupL3Forwarding(ctx, endpoint, queues, disableVhostNet)
 	default:
 		err = fmt.Errorf("Invalid internetworking model")
 	}
@@ -899,6 +907,8 @@ func xDisconnectVMNetwork(ctx context.Context, endpoint Endpoint) error {
 		err = untapNetworkPair(ctx, endpoint)
 	case NetXConnectTCFilterModel:
 		err = removeTCFiltering(ctx, endpoint)
+	case NetXConnectL3ForwardingModel:
+		err = removeL3Forwarding(ctx, endpoint)
 	default:
 		err = fmt.Errorf("Invalid internetworking model")
 	}
diff --git a/src/runtime/virtcontainers/network_port_forwarding_linux.go b/src/runtime/virtcontainers/network_port_forwarding_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..6d2f272ecf5cead5bee4baec2cc63c1043cff2db
--- /dev/null
+++ b/src/runtime/virtcontainers/network_port_forwarding_linux.go
@@ -0,0 +1,129 @@
+// Copyright (c) 2026 Edgeless Systems GmbH
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+// TODO(burgerdev): below is more or less unreviewed Claude code.
+
+package virtcontainers
+
+import (
+	"fmt"
+	"net"
+	"os/exec"
+	"strings"
+)
+
+const (
+	ipv4Loopback           = "127.0.0.1/32"
+	kataPortFwOutputChain  = "KATA_PORTFW_OUTPUT"
+	kataPortFwPostRtChain  = "KATA_PORTFW_POSTRT"
+	xtablesLockWaitSeconds = "5"
+)
+
+// configurePortForwarding sets up NAT rules so that connections made to
+// localhost inside the pod network namespace (as containerd does for
+// `kubectl port-forward`) reach the workload running inside the guest, and
+// so that the guest's replies are routed back to the caller. Failures are
+// logged and otherwise ignored: port-forwarding is a convenience on top of
+// l3forwarding, not a requirement for the network model to work.
+func configurePortForwarding(tapName string, podIPv4 net.IP, tapIPv4 net.IP) {
+	if err := configureIPv4PortForwarding(tapName, podIPv4, tapIPv4); err != nil {
+		networkLogger().WithError(err).Warn("failed to configure IPv4 port-forward NAT; continuing without it")
+	}
+}
+
+func configureIPv4PortForwarding(tapName string, podIP net.IP, tapIP net.IP) error {
+	iptables, err := detectIPTablesBinary()
+	if err != nil {
+		return err
+	}
+
+	podCIDR := podIP.String() + "/32"
+
+	if err := runIPTables(iptables, "-t", "nat", "-N", kataPortFwPostRtChain); err != nil {
+		return err
+	}
+	if err := runIPTables(iptables, "-t", "nat", "-N", kataPortFwOutputChain); err != nil {
+		return err
+	}
+
+	// Make replies from the guest routable back to the host-side pod
+	// namespace. Install this before DNAT so a partial failure cannot leave
+	// destination rewriting active without a valid reply path.
+	if err := runIPTables(iptables,
+		"-t", "nat", "-A", kataPortFwPostRtChain,
+		"-s", ipv4Loopback,
+		"-d", podCIDR,
+		"-o", tapName,
+		"-p", "tcp",
+		"-j", "SNAT", "--to-source", tapIP.String(),
+	); err != nil {
+		return err
+	}
+	if err := runIPTables(iptables, "-t", "nat", "-A", "POSTROUTING", "-j", kataPortFwPostRtChain); err != nil {
+		return err
+	}
+
+	// containerd port-forward connects to localhost inside the pod network
+	// namespace. Preserve the requested port while redirecting that
+	// connection to the workload inside the guest.
+	if err := runIPTables(iptables,
+		"-t", "nat", "-A", kataPortFwOutputChain,
+		"-s", ipv4Loopback,
+		"-d", ipv4Loopback,
+		"-p", "tcp",
+		"-j", "DNAT", "--to-destination", podIP.String(),
+	); err != nil {
+		return err
+	}
+	return runIPTables(iptables, "-t", "nat", "-A", "OUTPUT", "-j", kataPortFwOutputChain)
+}
+
+func runIPTables(binary string, args ...string) error {
+	// Note that "-w" is a no-op for iptables-nft.
+	cmdArgs := append([]string{"-w", xtablesLockWaitSeconds}, args...)
+	output, err := exec.Command(binary, cmdArgs...).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("%s %s failed: %s: %s", binary, strings.Join(args, " "), strings.TrimSpace(string(output)), err)
+	}
+	return nil
+}
+
+// detectIPTablesBinary picks which iptables binary to use, following the
+// same heuristic as Istio's istio-iptables:
+// https://github.com/istio/istio/blob/1ef2d93c3b1ba12922d2e8e1384e4ec7317a973f/tools/istio-iptables/pkg/dependencies/implementation.go#L179-L210
+// In short: if "iptables-legacy" is available and has rules, use it. If
+// "iptables-nft" is available, use it. If "iptables" (which symlinks to
+// iptables-nft or iptables-legacy) is available, use it. Otherwise fail.
+func detectIPTablesBinary() (string, error) {
+	const legacy, plain, nft = "iptables-legacy", "iptables", "iptables-nft"
+
+	if output, ok := probeBinary(legacy); ok && hasRules(output) {
+		return legacy, nil
+	}
+	if _, ok := probeBinary(nft); ok {
+		return nft, nil
+	}
+	if _, ok := probeBinary(plain); ok {
+		return plain, nil
+	}
+
+	return "", fmt.Errorf("no usable IPv4 iptables binary found (tried %s, %s, %s)", legacy, nft, plain)
+}
+
+// hasRules checks if the output of iptablesxxx-save has any rules, using the
+// same heuristic as Istio:
+// https://github.com/istio/istio/blob/1ef2d93c3b1ba12922d2e8e1384e4ec7317a973f/tools/istio-iptables/pkg/dependencies/implementation_linux.go#L140-L144
+func hasRules(output string) bool {
+	return strings.Count(output, "\n") >= 3
+}
+
+// probeBinary assumes that iptablesxxx-save runs iff iptablesxxx is usable.
+func probeBinary(binary string) (string, bool) {
+	output, err := exec.Command(binary + "-save").Output()
+	if err != nil {
+		return "", false
+	}
+	return string(output), true
+}
